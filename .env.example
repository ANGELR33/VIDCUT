# Gemini keys: one per project, separated by commas to enable project failover.
GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# NVIDIA NIM: activa GLM-5.3, GLM-5.3-flash y Kimi-k3 en el Agente Copilot
# y el respaldo automatico de llm.py cuando Gemini esta saturado.
NVIDIA_API_KEY=your_nvidia_api_key_here

# API Externa / Integraciones (Opcional: Si se define, protege la API v1 con Bearer o X-API-Key)
AETHERCUT_API_KEY=

# Model Configuration
GEMINI_MODEL=gemini-3.6-flash

# Estudio de PublicaciÃ³n: miniaturas IA y subida directa a YouTube
# Key de Gemini con acceso a modelos de imagen (ej. AIzaSy...)
GEMINI_IMAGE_API_KEY=your_gemini_image_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OAuth 2.0 de Google Cloud (credencial tipo "Desktop app" o "Web application")
# Scopes: youtube.upload + youtube.readonly + youtube (gestión/cancelar programados)
YOUTUBE_CLIENT_ID=your_oauth_client_id_here
# Opcional con PKCE; obligatorio si Google lo exige para tu tipo de cliente
YOUTUBE_CLIENT_SECRET=
# Puerto local del server (debe coincidir con el redirect URI registrado en Google Cloud)
YOUTUBE_REDIRECT_PORT=8000

# Radar de Viralidad: key con YouTube Data API v3 activada
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here
# Regiones del ranking viral (ISO alpha-2, separadas por comas)
TREND_REGIONS=US,GB,CA

# Video Processing Defaults
MAX_SILENCE_DURATION_SEC=1.5
MIN_SPEECH_SEGMENT_SEC=0.4
DEFAULT_VIDEO_FPS=30

# Speechify TTS (opcional): una o varias claves separadas por comas.
SPEECHIFY_API_KEYS=

# Filtro de relevancia visual del B-Roll (0-10). Más alto = más estricto.
RELEVANCE_THRESHOLD=6
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
